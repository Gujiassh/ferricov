{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferricov.dev/schema/benchmark-suite-v1.json",
  "title": "Ferricov Oracle baseline suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "evidence_scope",
    "image_reference",
    "measurement_tool",
    "environment_variables",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "suite_id": { "$ref": "#/$defs/identifier" },
    "evidence_scope": { "const": "oracle_baseline" },
    "image_reference": { "type": "string", "minLength": 1 },
    "measurement_tool": { "$ref": "#/$defs/repository_artifact" },
    "environment_variables": {
      "const": { "LC_ALL": "C", "TZ": "UTC" }
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^[^/]+(/[^/]+)*$"
    },
    "repository_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "tree_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "tree_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representative", "status", "basis"],
      "properties": {
        "representative": { "const": true },
        "status": { "const": "approved" },
        "basis": { "const": "owner-directed-m0-oracle-baseline" }
      }
    },
    "correctness_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_evidence_scope", "required_status"],
      "properties": {
        "required_evidence_scope": { "const": "compatibility" },
        "required_status": { "const": "pass" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "approval",
        "command",
        "arguments",
        "fixture",
        "inventory_entries",
        "warmup_runs",
        "measured_runs",
        "expected_exit_code",
        "correctness_requirement"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "family": {
          "enum": ["startup", "tracefile", "operation", "report"]
        },
        "approval": { "$ref": "#/$defs/approval" },
        "command": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fixture": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/fixture" }
          ]
        },
        "inventory_entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "warmup_runs": { "type": "integer", "minimum": 1 },
        "measured_runs": { "type": "integer", "minimum": 1 },
        "expected_exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "correctness_requirement": { "$ref": "#/$defs/correctness_requirement" }
      }
    }
  }
}

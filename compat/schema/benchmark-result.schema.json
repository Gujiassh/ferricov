{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferricov.dev/schema/benchmark-result-v1.json",
  "title": "Ferricov Oracle-only baseline result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "recorded_at",
    "status",
    "performance_gate",
    "correctness_gate",
    "suite",
    "execution_manifest",
    "measurement_tool",
    "raw_samples",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "result_id": { "$ref": "#/$defs/identifier" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "status": { "const": "baseline_only" },
    "performance_gate": {
      "const": {
        "status": "not_evaluated",
        "reason": "candidate_not_available"
      }
    },
    "correctness_gate": {
      "const": {
        "status": "not_evaluated",
        "reason": "candidate_not_available",
        "required_evidence_scope": "compatibility",
        "evidence": null
      }
    },
    "suite": { "$ref": "#/$defs/repository_artifact" },
    "execution_manifest": { "$ref": "#/$defs/repository_artifact" },
    "measurement_tool": { "$ref": "#/$defs/repository_artifact" },
    "raw_samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result_artifact" }
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/case_result" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^[^/]+(/[^/]+)*$"
    },
    "artifact_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "repository_artifact": { "$ref": "#/$defs/artifact_base" },
    "result_artifact": { "$ref": "#/$defs/artifact_base" },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "median", "maximum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 0 },
        "median": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured_samples",
        "wall_time_ns",
        "user_cpu_time_ns",
        "system_cpu_time_ns",
        "peak_rss_bytes",
        "output_bytes",
        "output_files"
      ],
      "properties": {
        "measured_samples": { "type": "integer", "minimum": 1 },
        "wall_time_ns": { "$ref": "#/$defs/distribution" },
        "user_cpu_time_ns": { "$ref": "#/$defs/distribution" },
        "system_cpu_time_ns": { "$ref": "#/$defs/distribution" },
        "peak_rss_bytes": { "$ref": "#/$defs/distribution" },
        "output_bytes": { "type": "integer", "minimum": 0 },
        "output_files": { "type": "integer", "minimum": 0 }
      }
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "family",
        "warmup_samples",
        "measured_samples",
        "summary"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/identifier" },
        "family": { "enum": ["startup", "tracefile", "operation", "report"] },
        "warmup_samples": { "type": "integer", "minimum": 1 },
        "measured_samples": { "type": "integer", "minimum": 1 },
        "summary": { "$ref": "#/$defs/summary" }
      }
    }
  }
}

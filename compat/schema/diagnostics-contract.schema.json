{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gujiassh/ferricov/compat/schema/diagnostics-contract.schema.json",
  "title": "Ferricov LCOV 2.5 Diagnostics Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "upstream_release",
    "upstream_commit",
    "scope",
    "artifact_bindings",
    "categories",
    "control_rules",
    "unclassified_surfaces",
    "exit_policies",
    "planned_case_ids",
    "planned_case_evidence_status",
    "planned_case_product_evidence",
    "oracle_observations",
    "oracle_observation_evidence_status",
    "oracle_observation_product_evidence",
    "known_evidence_gaps",
    "totals",
    "product_compatibility_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "upstream_release": { "const": "v2.5" },
    "upstream_commit": { "const": "74c8eabbb36d7cf2454d3f0ea37bf1337641cbc5" },
    "scope": { "type": "string", "minLength": 1 },
    "artifact_bindings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/artifactBinding" }
    },
    "categories": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/category" }
    },
    "control_rules": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/reviewedRule" }
    },
    "unclassified_surfaces": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/surface" }
    },
    "exit_policies": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/exitPolicy" }
    },
    "planned_case_ids": {
      "type": "array",
      "minItems": 71,
      "maxItems": 71,
      "items": { "type": "string", "pattern": "^(DIAG|PAR)-[A-Z0-9-]+$" }
    },
    "planned_case_evidence_status": { "const": "planned" },
    "planned_case_product_evidence": { "$ref": "#/$defs/productEvidence" },
    "oracle_observations": {
      "type": "array",
      "minItems": 53,
      "maxItems": 53,
      "items": { "$ref": "#/$defs/oracleObservation" }
    },
    "oracle_observation_evidence_status": { "const": "oracle_reference" },
    "oracle_observation_product_evidence": { "$ref": "#/$defs/productEvidence" },
    "known_evidence_gaps": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "totals": { "$ref": "#/$defs/totals" },
    "product_compatibility_evidence": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "productEvidence": { "type": "array", "maxItems": 0 },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "role", "text"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["registry", "control", "surface", "exit"] },
        "text": { "type": "string" }
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "upstream_symbol", "upstream_numeric_id",
        "emitter_status", "registry_source", "symbol_reference_count",
        "symbol_references_sha256", "review_status", "product_evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^diagnostic\\.category\\." },
        "name": { "type": "string", "pattern": "^[a-z]+$" },
        "upstream_symbol": { "type": "string", "pattern": "^ERROR_[A-Z_]+$" },
        "upstream_numeric_id": { "type": "integer", "minimum": 0, "maximum": 31 },
        "emitter_status": { "enum": ["emitted", "reserved_no_production_emitter"] },
        "registry_source": { "$ref": "#/$defs/sourceReference" },
        "symbol_reference_count": { "type": "integer", "minimum": 1 },
        "symbol_references_sha256": { "$ref": "#/$defs/sha256" },
        "review_status": { "const": "reviewed" },
        "product_evidence": { "$ref": "#/$defs/productEvidence" }
      }
    },
    "reviewedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "behavior", "source_references", "review_status", "product_evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^diagnostic\\.control\\." },
        "behavior": { "type": "string", "minLength": 1 },
        "source_references": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceReference" } },
        "review_status": { "const": "reviewed" },
        "product_evidence": { "$ref": "#/$defs/productEvidence" }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "behavior", "source_references", "review_status", "product_evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^diagnostic\\.surface\\." },
        "family": { "enum": ["parser_error", "raw_perl_failure", "native_python_diagnostic", "early_dependency_failure"] },
        "behavior": { "type": "string", "minLength": 1 },
        "source_references": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceReference" } },
        "review_status": { "const": "reviewed" },
        "product_evidence": { "$ref": "#/$defs/productEvidence" }
      }
    },
    "exitPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "policy", "source_references", "review_status", "product_evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^diagnostic\\.exit-policy\\." },
        "command": { "type": "string", "minLength": 1 },
        "policy": { "enum": ["shared_saw_error_fold", "criteria_only_no_saw_error_fold", "native_python_keep_going", "library_no_cli_entrypoint", "direct_perl_exit"] },
        "source_references": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceReference" } },
        "review_status": { "const": "reviewed" },
        "product_evidence": { "$ref": "#/$defs/productEvidence" }
      }
    },
    "oracleObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "planned_case_ids", "exit_status", "stdout_sha256", "stderr_sha256", "output_sha256", "observation_sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^(correctness|tracefile):.+$" },
        "kind": { "enum": ["startup_boundary", "startup_environment_intercept", "parser_boundary", "configuration_error_control", "named_error_fatal", "named_error_ignore_one"] },
        "planned_case_ids": { "type": "array", "items": { "type": "string", "pattern": "^(DIAG|PAR)-[A-Z0-9-]+$" } },
        "exit_status": { "type": "integer", "minimum": 0 },
        "stdout_sha256": { "$ref": "#/$defs/sha256" },
        "stderr_sha256": { "$ref": "#/$defs/sha256" },
        "output_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "observation_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "category_symbol_references", "reserved_categories", "control_rules", "unclassified_surfaces", "exit_policies", "planned_cases", "oracle_observations", "startup_observations", "parser_observations", "configuration_observations", "named_error_fatal_observations", "named_error_ignore_one_observations"],
      "properties": {
        "categories": { "const": 32 },
        "category_symbol_references": { "const": 399 },
        "reserved_categories": { "const": 1 },
        "control_rules": { "const": 9 },
        "unclassified_surfaces": { "const": 4 },
        "exit_policies": { "const": 10 },
        "planned_cases": { "const": 71 },
        "oracle_observations": { "const": 53 },
        "startup_observations": { "const": 10 },
        "parser_observations": { "const": 10 },
        "configuration_observations": { "const": 5 },
        "named_error_fatal_observations": { "const": 20 },
        "named_error_ignore_one_observations": { "const": 8 }
      }
    }
  }
}

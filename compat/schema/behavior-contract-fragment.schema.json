{
  "$comment": "Fragments author behavior-contract-owned subjects, behavior groups, interaction groups, planned cases, and evidence. They do not project those relationships back into the executable-surface inventory.",
  "$id": "https://ferricov.dev/schema/behavior-contract-fragment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://ferricov.dev/schema/behavior-contract-fragment.schema.json"
    },
    "behavior_groups": {
      "items": {
        "$ref": "https://ferricov.dev/schema/behavior-contract.schema.json#/$defs/behavior_group"
      },
      "type": "array",
      "uniqueItems": true
    },
    "case_groups": {
      "items": {
        "$ref": "https://ferricov.dev/schema/behavior-contract.schema.json#/$defs/case_group"
      },
      "type": "array",
      "uniqueItems": true
    },
    "description": {
      "minLength": 40,
      "type": "string"
    },
    "fragment_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "type": "string"
    },
    "fragment_type": {
      "enum": [
        "authored",
        "generated"
      ]
    },
    "interaction_groups": {
      "items": {
        "$ref": "https://ferricov.dev/schema/behavior-contract.schema.json#/$defs/interaction_group"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": 1
    },
    "subjects": {
      "items": {
        "$ref": "https://ferricov.dev/schema/behavior-contract.schema.json#/$defs/subject"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "fragment_id",
    "fragment_type",
    "description",
    "subjects",
    "behavior_groups",
    "interaction_groups",
    "case_groups"
  ],
  "title": "Ferricov behavior-contract authoring fragment",
  "type": "object"
}

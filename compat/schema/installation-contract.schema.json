{
  "$defs": {
    "artifactBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "assetObservation": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "minLength": 1,
          "type": "string"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "asset_count": {
          "const": 7
        },
        "asset_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "id": {
          "pattern": "^installation\\.asset-observation\\.",
          "type": "string"
        },
        "sample_metadata_path": {
          "pattern": "/sample\\.json$",
          "type": "string"
        },
        "sample_metadata_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "artifact_path",
        "artifact_sha256",
        "sample_metadata_path",
        "sample_metadata_sha256",
        "asset_set_sha256",
        "asset_count"
      ],
      "type": "object"
    },
    "benchmarkResult": {
      "additionalProperties": false,
      "properties": {
        "correctness_gate_status": {
          "const": "not_evaluated"
        },
        "performance_gate_status": {
          "const": "not_evaluated"
        },
        "product_compatibility_evidence": {
          "const": false
        },
        "result_id": {
          "const": "m0-oracle-baseline-oracle"
        },
        "status": {
          "const": "baseline_only"
        }
      },
      "required": [
        "result_id",
        "status",
        "correctness_gate_status",
        "performance_gate_status",
        "product_compatibility_evidence"
      ],
      "type": "object"
    },
    "installedTree": {
      "additionalProperties": false,
      "properties": {
        "directory_entries_retained": {
          "const": false
        },
        "entry_count": {
          "const": 321
        },
        "file_count": {
          "const": 320
        },
        "file_identity_algorithm": {
          "const": "sha256"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/treeGroup"
          },
          "maxItems": 9,
          "minItems": 9,
          "type": "array"
        },
        "legacy_symlink": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "777"
            },
            "path": {
              "const": "/usr/local/man"
            },
            "target": {
              "const": "share/man"
            }
          },
          "required": [
            "path",
            "target",
            "mode"
          ],
          "type": "object"
        },
        "manifest_path": {
          "const": "compat/upstream/installed-tree.lock"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mode_counts": {
          "additionalProperties": false,
          "properties": {
            "644": {
              "const": 210
            },
            "755": {
              "const": 110
            },
            "777": {
              "const": 1
            }
          },
          "required": [
            "644",
            "755",
            "777"
          ],
          "type": "object"
        },
        "path_order": {
          "const": "lexicographic"
        },
        "path_root": {
          "const": "/usr/local"
        },
        "symlink_count": {
          "const": 1
        }
      },
      "required": [
        "manifest_path",
        "manifest_sha256",
        "path_root",
        "path_order",
        "file_identity_algorithm",
        "legacy_symlink",
        "entry_count",
        "file_count",
        "symlink_count",
        "mode_counts",
        "directory_entries_retained",
        "groups"
      ],
      "type": "object"
    },
    "oracleCaseRecords": {
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "const": 13
        },
        "case_fact_sha256s": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "facts_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "id": {
                "pattern": "^INST-[A-Z0-9-]+$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "facts_sha256"
            ],
            "type": "object"
          },
          "maxItems": 13,
          "minItems": 13,
          "type": "array"
        },
        "case_ids": {
          "items": {
            "pattern": "^INST-[A-Z0-9-]+$",
            "type": "string"
          },
          "maxItems": 13,
          "minItems": 13,
          "type": "array"
        },
        "evidence_status": {
          "const": "oracle_reference"
        },
        "execution_status": {
          "const": "planned"
        },
        "path": {
          "const": "compat/installation/oracle-case-records.json"
        },
        "product_compatibility_evidence": {
          "const": false
        },
        "schema_path": {
          "const": "compat/installation/oracle-case-records.schema.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "schema_path",
        "sha256",
        "case_count",
        "evidence_status",
        "execution_status",
        "product_compatibility_evidence",
        "case_ids",
        "case_fact_sha256s"
      ],
      "type": "object"
    },
    "oracleCaseSummary": {
      "additionalProperties": false,
      "properties": {
        "evidence_status": {
          "const": "oracle_reference"
        },
        "execution_status": {
          "const": "planned"
        },
        "facts_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "failure_contract_count": {
          "minimum": 0,
          "type": "integer"
        },
        "family": {
          "enum": [
            "layout",
            "lifecycle",
            "failure",
            "asset",
            "license"
          ]
        },
        "id": {
          "pattern": "^INST-[A-Z0-9-]+$",
          "type": "string"
        },
        "layout_contract_count": {
          "minimum": 0,
          "type": "integer"
        },
        "observation_count": {
          "minimum": 0,
          "type": "integer"
        },
        "product_evidence": {
          "$ref": "#/$defs/productEvidence"
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "source_closure_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "family",
        "role",
        "evidence_status",
        "execution_status",
        "facts_sha256",
        "source_closure_count",
        "layout_contract_count",
        "failure_contract_count",
        "observation_count",
        "product_evidence"
      ],
      "type": "object"
    },
    "oracleManifest": {
      "additionalProperties": false,
      "properties": {
        "evidence_scope": {
          "const": "environment_smoke"
        },
        "manifest_id": {
          "const": "oracle-lcov-v2.5-image-smoke"
        },
        "product_compatibility_evidence": {
          "const": false
        },
        "status": {
          "const": "observed"
        }
      },
      "required": [
        "manifest_id",
        "status",
        "evidence_scope",
        "product_compatibility_evidence"
      ],
      "type": "object"
    },
    "productEvidence": {
      "maxItems": 0,
      "type": "array"
    },
    "runtimeAsset": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z0-9-]+$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "css",
            "png"
          ]
        },
        "name": {
          "pattern": "^[a-z]+(?:[.-][a-z]+)*$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "sourceClosure": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^installation\\.",
          "type": "string"
        },
        "line_count": {
          "minimum": 1,
          "type": "integer"
        },
        "line_end": {
          "minimum": 1,
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "enum": [
            "install_variables",
            "install_recipe",
            "uninstall_recipe",
            "interpreter_fixup",
            "documentation_build",
            "documentation_config",
            "man_page_generation",
            "config_discovery",
            "installed_test_runtime",
            "installed_test_paths",
            "installed_test_docs",
            "documented_paths",
            "report_asset_names",
            "report_asset_generation",
            "report_asset_writers"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "path",
        "line_start",
        "line_end",
        "line_count",
        "role",
        "sha256"
      ],
      "type": "object"
    },
    "totals": {
      "additionalProperties": false,
      "properties": {
        "artifact_bindings": {
          "const": 29
        },
        "failure_contract_ids": {
          "const": 10
        },
        "installed_tree_entries": {
          "const": 321
        },
        "installed_tree_groups": {
          "const": 9
        },
        "layout_contract_ids": {
          "const": 9
        },
        "oracle_case_records": {
          "const": 13
        },
        "planned_cases": {
          "const": 13
        },
        "runtime_asset_observations": {
          "const": 4
        },
        "runtime_assets": {
          "const": 7
        },
        "source_closures": {
          "const": 15
        },
        "source_lines": {
          "const": 600
        }
      },
      "required": [
        "artifact_bindings",
        "source_closures",
        "source_lines",
        "installed_tree_entries",
        "installed_tree_groups",
        "layout_contract_ids",
        "failure_contract_ids",
        "planned_cases",
        "runtime_assets",
        "runtime_asset_observations",
        "oracle_case_records"
      ],
      "type": "object"
    },
    "treeGroup": {
      "additionalProperties": false,
      "properties": {
        "entries_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entry_count": {
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "pattern": "^installation\\.tree\\.",
          "type": "string"
        },
        "kinds": {
          "items": {
            "enum": [
              "file",
              "symlink"
            ]
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "modes": {
          "items": {
            "enum": [
              "644",
              "755",
              "777"
            ]
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z_]+$",
          "type": "string"
        },
        "path_prefix": {
          "pattern": "^/usr/local",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "path_prefix",
        "entry_count",
        "kinds",
        "modes",
        "entries_sha256"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Gujiassh/ferricov/compat/schema/installation-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_bindings": {
      "items": {
        "$ref": "#/$defs/artifactBinding"
      },
      "maxItems": 29,
      "minItems": 29,
      "type": "array"
    },
    "benchmark_result": {
      "$ref": "#/$defs/benchmarkResult"
    },
    "failure_contract_ids": {
      "items": {
        "pattern": "^INST-[A-Z0-9-]+$",
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 10,
      "type": "array"
    },
    "installed_tree": {
      "$ref": "#/$defs/installedTree"
    },
    "known_evidence_gaps": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 13,
      "minItems": 13,
      "type": "array"
    },
    "layout_contract_ids": {
      "items": {
        "pattern": "^INST-[A-Z0-9-]+$",
        "type": "string"
      },
      "maxItems": 9,
      "minItems": 9,
      "type": "array"
    },
    "oracle_case_records": {
      "$ref": "#/$defs/oracleCaseRecords"
    },
    "oracle_case_summaries": {
      "items": {
        "$ref": "#/$defs/oracleCaseSummary"
      },
      "maxItems": 13,
      "minItems": 13,
      "type": "array"
    },
    "oracle_manifest": {
      "$ref": "#/$defs/oracleManifest"
    },
    "oracle_observation_evidence_status": {
      "const": "oracle_reference"
    },
    "oracle_observation_product_evidence": {
      "$ref": "#/$defs/productEvidence"
    },
    "planned_case_evidence_status": {
      "const": "planned"
    },
    "planned_case_ids": {
      "items": {
        "pattern": "^INST-[A-Z0-9-]+$",
        "type": "string"
      },
      "maxItems": 13,
      "minItems": 13,
      "type": "array"
    },
    "planned_case_product_evidence": {
      "$ref": "#/$defs/productEvidence"
    },
    "product_compatibility_evidence": {
      "const": false
    },
    "runtime_asset_observations": {
      "items": {
        "$ref": "#/$defs/assetObservation"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "runtime_assets": {
      "items": {
        "$ref": "#/$defs/runtimeAsset"
      },
      "maxItems": 7,
      "minItems": 7,
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "scope": {
      "minLength": 1,
      "type": "string"
    },
    "source_closures": {
      "items": {
        "$ref": "#/$defs/sourceClosure"
      },
      "maxItems": 15,
      "minItems": 15,
      "type": "array"
    },
    "totals": {
      "$ref": "#/$defs/totals"
    },
    "upstream_commit": {
      "const": "74c8eabbb36d7cf2454d3f0ea37bf1337641cbc5"
    },
    "upstream_release": {
      "const": "v2.5"
    }
  },
  "required": [
    "schema_version",
    "upstream_release",
    "upstream_commit",
    "scope",
    "artifact_bindings",
    "oracle_manifest",
    "benchmark_result",
    "source_closures",
    "installed_tree",
    "layout_contract_ids",
    "failure_contract_ids",
    "planned_case_ids",
    "planned_case_evidence_status",
    "planned_case_product_evidence",
    "oracle_case_summaries",
    "oracle_case_records",
    "runtime_assets",
    "runtime_asset_observations",
    "oracle_observation_evidence_status",
    "oracle_observation_product_evidence",
    "known_evidence_gaps",
    "totals",
    "product_compatibility_evidence"
  ],
  "title": "Ferricov LCOV 2.5 Installation Contract",
  "type": "object"
}

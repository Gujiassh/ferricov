{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferricov.invalid/schemas/core009-failure-sidecar-v1.json",
  "title": "CORE-009 minimized failure sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_id",
    "case_id",
    "seed",
    "raw_sha256",
    "minimized_sha256",
    "raw_artifact",
    "first_failing_operation",
    "semantic_snapshots",
    "process",
    "runtime_manifest",
    "origin_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target_id": {
      "type": "string",
      "pattern": "^M1-FZ-[A-Z-]+-001$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "minimized_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_artifact": {
      "type": "string",
      "pattern": "^[^/\\\\]+$"
    },
    "first_failing_operation": {
      "type": "string",
      "minLength": 1
    },
    "semantic_snapshots": {
      "type": "object"
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "signal",
        "timed_out",
        "stdout",
        "stderr"
      ],
      "properties": {
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        }
      }
    },
    "runtime_manifest": {
      "type": "object"
    },
    "origin_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^M1-(MD|TF|PROP|FZ)-"
      }
    },
    "minimized_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_artifact": {
      "type": "string",
      "pattern": "^[^/\\\\]+$"
    }
  }
}
